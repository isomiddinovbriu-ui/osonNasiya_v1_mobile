{
  "expo": {
    "name": "OsonNasiya",
    "slug": "osonNasiya_v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/login-logo.jpg",
    "scheme": "osonnasiyav1",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.isomiddinovirb.osonnasiya",
      "icon": "./assets/images/login-logo.jpg",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/login-logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.isomiddinov_irb.osonNasiya_v1"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/login-logo.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yaqin mijozlarni topish va mijoz manzilini belgilash uchun joylashuvga ruxsat bering."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mahsulot rasmlarini tanlash uchun suratlaringizga ruxsat bering.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/brand-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4165140-2dc0-4fc5-a2bc-e013e7ca64b4"
      }
    }
  }
}
